{
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "**/build/**",
    ".gradle/**",
    ".idea/**",
    ".kotlin/**",
    "gradle/wrapper/**",
    "gradle/gradle-daemon-jvm.properties",
    "gradlew",
    "gradlew.bat",
    "local.properties",
    "**/*.webp",
    "**/*.png",
    "**/res/mipmap*/**",
    "cspell.json",
    "docs/habit_tracker_featureliste.md",
    "gradle.properties",
    "app/schemas/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project",
      "path": "./cspell-project.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project"]
}
