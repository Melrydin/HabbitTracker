root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120

# Compose-Composables sind PascalCase, das kollidiert mit der Funktionsnamen-Regel.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Diese beiden Regeln brechen jede Signatur ab zwei Parametern auf eigene Zeilen,
# auch wenn sie bequem in 120 Zeichen passt. Das blaeht Funktionen auf und
# arbeitet damit gegen die 20-Zeilen-Regel aus CLAUDE.md. Die Zeilenlaenge
# deckt max_line_length bereits ab.
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled

# Ein Ausdruckskoerper ist nicht immer die lesbarere Form.
ktlint_standard_function-expression-body = disabled

[*.{xml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
