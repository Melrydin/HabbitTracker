root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120

# Composables are PascalCase, which collides with the function naming rule.
ktlint_function_naming_ignore_when_annotated_with = Composable

# These two rules break every signature with two or more parameters onto separate
# lines, even when it fits comfortably within 120 characters. That inflates
# functions and works against the 20 line rule from CLAUDE.md, while
# max_line_length already covers the line length itself.
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled

# An expression body is not always the more readable form.
ktlint_standard_function-expression-body = disabled

[*.{xml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
